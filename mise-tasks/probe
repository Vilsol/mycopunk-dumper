#!/usr/bin/env bash
#MISE description="Run the dump with the probe enabled — writes $MYCOPUNK_DIR/probe/{types.md,catalogs.txt,subclasses.txt,unlock-directives.txt,samples/}. Use this when exploring new game data before adding a dumper."
#MISE depends=["release"]
set -uo pipefail

# One game run at a time: parallel worktrees share $MYCOPUNK_DIR. Deploy inside the
# lock so another worktree can't swap the DLL between our deploy and launch.
exec 9>"$MYCOPUNK_DIR/.game.lock"
flock 9
"$(dirname "$0")/deploy"

DATA="$MYCOPUNK_DIR/data.json"
LOG="$MYCOPUNK_DIR/BepInEx/LogOutput.log"
PROBE_DIR="$MYCOPUNK_DIR/probe"
FLAG="$MYCOPUNK_DIR/probe.flag"

if ! pgrep -f "steamwebhelper " >/dev/null; then
    echo "ERROR: Steam is not running. Start Steam first." >&2
    exit 1
fi

pkill -f Mycopunk.exe >/dev/null 2>&1 || true
sleep 2

rm -rf "$PROBE_DIR" "$DATA" "$LOG"
touch "$FLAG"

steam "steam://rungameid/$MYCOPUNK_APPID" >/dev/null 2>&1 9>&- || true
echo "Launched Mycopunk with probe enabled at $(date +%T); waiting..."

for _ in $(seq 1 100); do
    if [[ -s "$DATA" ]]; then break; fi
    sleep 3
done

if [[ ! -s "$DATA" ]]; then
    rm -f "$FLAG"
    echo "ERROR: timeout — data.json never appeared. Last log lines:" >&2
    tail -20 "$LOG" >&2 2>/dev/null || true
    exit 1
fi

# Post-dump probes (Probe.RunAfterDump) keep going after data.json; wait for their
# done marker, or the game exiting/crashing, with a 15-minute cap.
for _ in $(seq 1 300); do
    if [[ -f "$PROBE_DIR/done" ]]; then break; fi
    pgrep -f '[M]ycopunk\.exe' >/dev/null || break
    sleep 3
done
rm -f "$FLAG"
if [[ ! -f "$PROBE_DIR/done" ]]; then
    echo "WARNING: post-dump probes didn't finish (no $PROBE_DIR/done). Last log lines:" >&2
    tail -20 "$LOG" >&2 2>/dev/null || true
fi

pkill -f Mycopunk.exe >/dev/null 2>&1 || true

if [[ -d "$PROBE_DIR" ]]; then
    # Copy out while still holding the game lock — the next run (possibly from another
    # worktree) wipes $PROBE_DIR.
    OUT="$(dirname "$(realpath "$0")")/../probe-out"
    rm -rf "$OUT"
    cp -r "$PROBE_DIR" "$OUT"
    cp "$DATA" "$LOG" "$OUT/"
    echo "Probe output copied to $(realpath "$OUT"):"
    ls -la "$OUT"
else
    echo "WARNING: probe directory not produced. Check Plugin.Probe.Run() and the flag-file path." >&2
fi
