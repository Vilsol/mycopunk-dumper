#!/usr/bin/env bash
#MISE description="Pack stripped + publicized Mycopunk_Data/Managed DLLs into ./gamelibs-out/Mycopunk.GameLibs.Steam.<version>.nupkg, versioned <game version>+<build id> from data.json"
set -euo pipefail

REPO="$(realpath "$(dirname "$0")/..")"
MANAGED="$MYCOPUNK_DIR/Mycopunk_Data/Managed"
DUMP="$MYCOPUNK_DIR/data.json"
OUT="$REPO/gamelibs-out"
PUBLICIZER="$HOME/.dotnet/tools/assembly-publicizer"

if [ ! -x "$PUBLICIZER" ]; then
    echo "assembly-publicizer not found. Install once with:" >&2
    echo "  dotnet tool install -g --version 0.4.3 BepInEx.AssemblyPublicizer.Cli" >&2
    exit 1
fi

# The game's version string comes from the dump, so this must run after a dump of the same build.
GAME_VERSION=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["gameVersion"]["Version"])' "$DUMP")
BUILD_ID=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["gameVersion"]["BuildID"])' "$DUMP")
# SemVer with the build ID as metadata. The game has shipped two-part versions (v2.0), so pad the patch.
# NuGet ignores +metadata for identity: a rebuild under the same game version is a duplicate and gets skipped.
if ! [[ "$BUILD_ID" =~ ^[0-9]+$ && "$GAME_VERSION" =~ ^v?([0-9]+)\.([0-9]+)(\.([0-9]+))?$ ]]; then
    echo "Unexpected game version '$GAME_VERSION' / build '$BUILD_ID' in $DUMP" >&2
    exit 1
fi
VERSION="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[4]:-0}+$BUILD_ID"

rm -rf "$OUT"
mkdir -p "$OUT/raw" "$OUT/lib"

# BCL assemblies come from the consumer's target framework.
find "$MANAGED" -maxdepth 1 -name '*.dll' \
    ! -name 'System*' ! -name 'Mono*' ! -name 'mscorlib.dll' ! -name 'netstandard.dll' \
    -exec cp {} "$OUT/raw/" \;

# firstpass isn't in every build (the CI depot download lacks it), so publicize whichever exist.
PUBLICIZE=()
for f in Assembly-CSharp.dll Assembly-CSharp-firstpass.dll; do
    [ -f "$OUT/raw/$f" ] && PUBLICIZE+=("$OUT/raw/$f")
done
"$PUBLICIZER" --strip -f -o "$OUT/lib" "${PUBLICIZE[@]}" >/dev/null
rm "${PUBLICIZE[@]}"
"$PUBLICIZER" --strip-only -f -o "$OUT/lib" "$OUT/raw/"*.dll >/dev/null

dotnet pack "$REPO/gamelibs/Mycopunk.GameLibs.Steam.csproj" \
    -p:LibDir="$OUT/lib" -p:PackageVersion="$VERSION" \
    -o "$OUT" --nologo -v quiet

echo "Packed $OUT/Mycopunk.GameLibs.Steam.${VERSION%+*}.nupkg ($VERSION, $(find "$OUT/lib" -name '*.dll' | wc -l) DLLs)"
