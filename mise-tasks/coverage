#!/usr/bin/env bash
#MISE description="List game catalogs, Global fields and prefab components the dumper doesn't reference. Reads the last `mise run probe` output (./probe-out/) + ./decompiled/."
set -euo pipefail

root="$(dirname "$0")/.."
if [[ ! -f "$root/probe-out/catalogs.txt" ]]; then
    echo "ERROR: no probe output at $root/probe-out — run 'mise run probe' first." >&2
    exit 1
fi

exec python3 "$root/tools/coverage.py" "$root/probe-out" "$root/src" "$root/decompiled"
